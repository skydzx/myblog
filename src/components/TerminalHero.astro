---
import { getCollection } from "astro:content";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@utils/content-utils";

type Stat = { value: number; label: string };

const [posts, categories, tags, kbEntries] = await Promise.all([
	getSortedPosts(),
	getCategoryList(),
	getTagList(),
	getCollection("kb"),
]);

const stats: Stat[] = [
	{ value: posts.length, label: "文章" },
	{ value: categories.length, label: "分类" },
	{ value: tags.length, label: "标签" },
	{ value: kbEntries.length, label: "知识库" },
];
---

<div class="terminal-hero font-code rounded-[var(--radius-large)] overflow-hidden bg-[var(--terminal-bg)] border border-[var(--line-color)] transition onload-animation">
	<div class="flex items-center gap-1.5 px-4 pt-3 pb-2 border-b border-white/10">
		<span class="w-3 h-3 rounded-full bg-[var(--terminal-dot-red)]"></span>
		<span class="w-3 h-3 rounded-full bg-[var(--terminal-dot-yellow)]"></span>
		<span class="w-3 h-3 rounded-full bg-[var(--terminal-dot-green)]"></span>
		<span class="ml-2 text-xs tracking-wider text-[var(--terminal-muted)] select-none">极弈侠@棋密: ~</span>
	</div>
	<div class="px-5 py-4 text-sm">
		<p class="mb-1 text-[var(--terminal-muted)]">
			<span class="font-bold text-[var(--terminal-prompt)]">$</span> whoami
		</p>
		<p class="mb-3 pl-4 text-[var(--terminal-text)]">网络安全 · 密码学 · AI 安全 学习者</p>
		<p class="mb-1 text-[var(--terminal-muted)]">
			<span class="font-bold text-[var(--terminal-prompt)]">$</span> ls ./stats
		</p>
		<div class="pl-4 flex flex-wrap gap-x-5 gap-y-1 text-[var(--terminal-text)]">
			{stats.map((s) => (
				<span>
					<span class="font-bold text-[var(--terminal-prompt)]">{s.value}</span>
					<span class="ml-1 text-[var(--terminal-muted)]">{s.label}</span>
				</span>
			))}
		</div>
	</div>
</div>
