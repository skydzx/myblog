---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

type SubcatItem = { name: string; count: number };

type ArticleData = {
	cat: string;
	subcat: string | null;
	backHref: string;
	backLabel: string;
};

type CategoryData = {
	prefixStr: string;
	breadcrumb: string[];
	subcatList: SubcatItem[];
	articles: CollectionEntry<"kb">[];
	isEmpty: boolean;
};

type RenderContent = Awaited<ReturnType<typeof render>>["Content"];

// 统一处理任意深度的知识库路由：
//   /kb/{category}/                          → 大类页（列出子分类 + 直属文章）
//   /kb/{category}/{subcategory}/            → 子分类页（列出文章）
//   /kb/{category}/{subcategory}/{article}/  → 文章页
export async function getStaticPaths() {
	const entries = await getCollection("kb");

	const articlePaths = entries.map((e) => ({
		params: { slug: e.id.replace(/\.md$/, "") },
		props: { entry: e },
	}));

	const segments = new Set<string>();
	for (const e of entries) {
		const parts = e.id.replace(/\.md$/, "").split("/");
		segments.add(parts[0]);
		if (parts.length >= 3) {
			segments.add(parts.slice(0, 2).join("/"));
		}
	}

	const categoryPaths = Array.from(segments).map((seg) => ({
		params: { slug: seg },
		props: { entry: null, prefix: seg },
	}));

	return [...categoryPaths, ...articlePaths];
}

const { slug } = Astro.params;
const { entry, prefix } = Astro.props;

// ---- 前置计算：文章 or 分类页 ----
let Content: RenderContent | null = null;
let articleData: ArticleData | null = null;
let categoryData: CategoryData = {
	prefixStr: "",
	breadcrumb: [],
	subcatList: [],
	articles: [],
	isEmpty: true,
};

if (entry) {
	// 文章页
	const parts = entry.id.replace(/\.md$/, "").split("/");
	const cat = parts[0];
	const subcat = parts.length >= 3 ? parts[1] : null;

	const rendered = await render(entry);
	Content = rendered.Content;

	articleData = {
		cat,
		subcat,
		backHref: subcat ? `/kb/${cat}/${subcat}/` : `/kb/${cat}/`,
		backLabel: subcat ? `返回 ${cat} / ${subcat}` : `返回 ${cat}`,
	};
} else {
	// 分类页（大类 或 子分类）
	const allEntries = await getCollection("kb");
	const prefixStr = prefix as string;
	const prefixLen = prefixStr.split("/").length;

	const subcategories = new Set<string>();
	for (const e of allEntries) {
		const id = e.id.replace(/\.md$/, "");
		if (!id.startsWith(`${prefixStr}/`)) continue;
		const parts = id.split("/");
		// 仅当路径比「当前节点+1」更深时才算真正的子分类目录（避免把文章文件名误判为子分类）
		if (parts.length > prefixLen + 1) {
			subcategories.add(parts[prefixLen]);
		}
	}

	const articles = allEntries
		.filter((e) => {
			const id = e.id.replace(/\.md$/, "");
			return (
				id.startsWith(`${prefixStr}/`) && id.split("/").length === prefixLen + 1
			);
		})
		.sort((a, b) => {
			const da = a.data.date ?? new Date(0);
			const db = b.data.date ?? new Date(0);
			return db.getTime() - da.getTime();
		});

	const subcatList = Array.from(subcategories).map((sub) => ({
		name: sub,
		count: allEntries.filter((e) => {
			const id = e.id.replace(/\.md$/, "");
			return id.startsWith(`${prefixStr}/${sub}/`);
		}).length,
	}));

	const breadcrumb = prefixStr.split("/");

	categoryData = {
		prefixStr,
		breadcrumb,
		subcatList,
		articles,
		isEmpty: subcatList.length === 0 && articles.length === 0,
	};
}
---
{
	articleData ? (
		<MainGridLayout title={`${entry!.data.title} - 知识库`} description={entry!.data.summary || entry!.data.title}>
			<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
				<div class="card-base z-10 px-9 py-6 relative w-full">
					<a href={articleData.backHref} class="text-sm text-[var(--text-muted)] no-underline hover:text-[var(--primary)] transition mb-4 inline-block">
						{`← ${articleData.backLabel}`}
					</a>
					<h1 class="text-2xl font-bold mb-2">{entry!.data.title}</h1>
					<div class="flex flex-wrap items-center gap-3 text-sm text-[var(--text-muted)] mb-6">
						{entry!.data.date ? (
							<span>{"📅 " + entry!.data.date.toISOString().slice(0, 10)}</span>
						) : null}
						{entry!.data.tags && entry!.data.tags.length > 0 ? (
							<span class="flex flex-wrap gap-1">
								{entry!.data.tags.map((t: string) => (
									<span class="bg-[var(--card-bg-secondary)] px-2 py-0.5 rounded text-xs">{t}</span>
								))}
							</span>
						) : null}
					</div>
					<Markdown class="mt-2">
						{Content ? <Content /> : null}
					</Markdown>
				</div>
			</div>
		</MainGridLayout>
	) : (
		<MainGridLayout
			title={`${categoryData.breadcrumb[categoryData.breadcrumb.length - 1]} - 知识库`}
			description={`${categoryData.breadcrumb[categoryData.breadcrumb.length - 1]} - 知识库`}
		>
			<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
				<div class="card-base z-10 px-9 py-6 relative w-full">
					<a href="/kb/" class="text-sm text-[var(--text-muted)] no-underline hover:text-[var(--primary)] transition mb-4 inline-block">
						← 返回知识库首页
					</a>

					{/* 面包屑 */}
					<div class="flex items-center gap-1 text-sm text-[var(--text-muted)] mb-4">
						{categoryData.breadcrumb.map((seg: string, i: number) => (
							<span class="flex items-center gap-1">
								{i > 0 && <span>/</span>}
								{i < categoryData.breadcrumb.length - 1 ? (
									<a href={`/kb/${categoryData.breadcrumb.slice(0, i + 1).join("/")}/`} class="hover:text-[var(--primary)] no-underline">
										{seg}
									</a>
								) : (
									<span class="text-[var(--text)] font-medium">{seg}</span>
								)}
							</span>
						))}
					</div>

					<h1 class="text-2xl font-bold mb-2">{categoryData.breadcrumb[categoryData.breadcrumb.length - 1]}</h1>

					{/* 子分类 */}
					{categoryData.subcatList.length > 0 && (
						<>
							<p class="text-sm text-[var(--text-muted)] mt-6 mb-3">子分类</p>
							<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
								{categoryData.subcatList.map((sub) => (
									<a
										href={`/kb/${categoryData.prefixStr}/${sub.name}/`}
										class="card-base px-4 py-3 flex items-center gap-2 transition border border-[var(--line-color)] hover:border-[var(--primary)] no-underline"
									>
										<span class="font-medium text-[var(--text)] flex-1 truncate">{sub.name}</span>
										<span class="text-xs text-[var(--text-muted)] bg-[var(--card-bg-secondary)] px-2 py-0.5 rounded-full">
											{sub.count}
										</span>
										<Icon name="material-symbols:chevron-right-rounded" class="text-[var(--text-muted)] text-xl shrink-0"></Icon>
									</a>
								))}
							</div>
						</>
					)}

					{/* 文章列表 */}
					{categoryData.articles.length > 0 && (
						<>
							<p class="text-sm text-[var(--text-muted)] mt-4 mb-3">文章</p>
							<div class="space-y-3">
								{categoryData.articles.map((a) => {
									const id = a.id.replace(/\.md$/, "");
									const href = `/kb/${id}/`;
									return (
										<a href={href} class="card-base px-4 py-3 block transition border border-[var(--line-color)] hover:border-[var(--primary)] no-underline">
											<div class="flex items-start justify-between gap-4">
												<div class="min-w-0">
													<div class="font-medium text-[var(--text)]">{a.data.title}</div>
													{a.data.summary ? (
														<p class="text-sm text-[var(--text-muted)] mt-1 line-clamp-1">{a.data.summary}</p>
													) : null}
												</div>
												<div class="flex items-center gap-3 shrink-0">
													{a.data.date ? (
														<span class="text-xs text-[var(--text-muted)] whitespace-nowrap">
															{a.data.date.toISOString().slice(0, 10)}
														</span>
													) : null}
													<Icon name="material-symbols:chevron-right-rounded" class="text-[var(--text-muted)] text-xl"></Icon>
												</div>
											</div>
										</a>
									);
								})}
							</div>
						</>
					)}

					{/* 空目录 */}
					{categoryData.isEmpty && (
						<p class="text-sm text-[var(--text-muted)] mt-4">这个分类还没有内容，敬请期待。</p>
					)}
				</div>
			</div>
		</MainGridLayout>
	)
}
