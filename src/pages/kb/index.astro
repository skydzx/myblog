---
import { getCollection } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const allEntries = await getCollection("kb");

type CatInfo = { name: string; count: number };
const cats: Record<string, CatInfo> = {};
for (const entry of allEntries) {
	const [cat] = entry.id.split("/");
	if (!cat) continue;
	if (!cats[cat]) cats[cat] = { name: cat, count: 0 };
	cats[cat].count++;
}
const categoryList = Object.values(cats).sort((a, b) =>
	a.name.localeCompare(b.name, "zh-CN"),
);

const totalCount = allEntries.length;
---
<MainGridLayout title="知识库" description="Personal Knowledge Base">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<h1 class="text-2xl font-bold mb-2">知识库</h1>
			<p class="text-sm text-[var(--text-muted)] mb-6">
				共计 {totalCount} 篇文章，{categoryList.length} 个分类。
			</p>

			<!-- 分类树 -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
				{categoryList.map((cat) => (
					<a
						href={`/kb/${cat.name}/`}
						class="card-base px-4 py-3 flex items-center justify-between transition hover:border-[var(--primary)] hover:shadow-sm no-underline"
					>
						<span class="font-medium text-[var(--text)]">{cat.name}</span>
						<span class="text-xs text-[var(--text-muted)] bg-[var(--card-bg-secondary)] px-2 py-0.5 rounded-full">
							{cat.count}
						</span>
					</a>
				))}
			</div>
		</div>
	</div>
</MainGridLayout>
