---
import MainGridLayout from "@layouts/MainGridLayout.astro";

const envCheckBlock = `# 检查前后端服务状态
curl -s http://127.0.0.1:8000/api/knowledge/stats
netstat -ano | findstr :8000  # 后端端口
netstat -ano | findstr :3000  # 前端端口

# 查看后端日志
tail -30 /tmp/backend.log`;

const playwrightBlock = `# 安装 Playwright (如果需要)
npm install playwright

# 运行测试
npx playwright test

# 导航到页面
await playwright_navigate({url: "http://localhost:3000/dashboard"})

# 截图
await playwright_screenshot({name: "screenshot"})

# 获取控制台日志
await playwright_console_logs({type: "error"})

# 点击元素
await playwright_click({selector: "button:has-text('查询')"})

# 填写表单
await playwright_fill({selector: "textarea", value: "测试问题"})`;

const corsFixBlock = `app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # 开发环境
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)`;

const fullTestBlock = `# 完整测试流程
cd /d/PycharmProjects/AI知识库/backend && .venv/Scripts/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &
cd /d/PycharmProjects/AI知识库/frontend && npm run dev &
sleep 15
curl -s http://127.0.0.1:8000/api/knowledge/stats | head -c 200`;
---
<MainGridLayout title="Software Testing Skill - 文档" description="Playwright 自动化测试技能文档">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full prose dark:prose-invert prose-base !max-w-none custom-md">

			<a href="/docs/" class="text-sm text-[var(--text-muted)] no-underline hover:text-[var(--primary)] transition mb-4 inline-block">← 返回文档</a>
			<h1>🧪 软件测试技能 (Software Testing Skill)</h1>
			<p>本技能用于系统地测试和调试前端应用，包括 Playwright 自动化测试、问题定位和修复。</p>

			<h2 id="env-check">1. 环境检查</h2>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{envCheckBlock}</pre>

			<h2 id="startup">2. 启动测试环境</h2>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{`# 启动后端 (在 backend 目录)
.venv/Scripts/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

# 启动前端 (在 frontend 目录)
npm run dev`}</pre>

			<h2 id="playwright">3. Playwright 测试步骤</h2>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{playwrightBlock}</pre>

			<h2 id="troubleshoot">4. 常见错误排查</h2>
			<table class="w-full text-sm border-collapse mb-4">
				<thead>
					<tr class="border-b border-[var(--border-color)]">
						<th class="text-left py-2 px-3">错误类型</th>
						<th class="text-left py-2 px-3">可能原因</th>
						<th class="text-left py-2 px-3">排查方法</th>
					</tr>
				</thead>
				<tbody>
					<tr class="border-b border-[var(--border-color)]">
						<td class="py-2 px-3"><code>ERR_CONNECTION_REFUSED</code></td>
						<td class="py-2 px-3">后端未启动/端口错误</td>
						<td class="py-2 px-3">检查后端进程和端口</td>
					</tr>
					<tr class="border-b border-[var(--border-color)]">
						<td class="py-2 px-3"><code>CORS policy</code></td>
						<td class="py-2 px-3">CORS 配置问题</td>
						<td class="py-2 px-3">检查后端 CORS_ORIGINS 配置</td>
					</tr>
					<tr class="border-b border-[var(--border-color)]">
						<td class="py-2 px-3">空白页面</td>
						<td class="py-2 px-3">前端编译错误</td>
						<td class="py-2 px-3">检查浏览器控制台</td>
					</tr>
					<tr class="border-b border-[var(--border-color)]">
						<td class="py-2 px-3">数据不显示</td>
						<td class="py-2 px-3">API 调用失败</td>
						<td class="py-2 px-3">检查网络请求和后端日志</td>
					</tr>
				</tbody>
			</table>

			<h3>排查步骤</h3>
			<ol class="list-decimal pl-5 space-y-2 mb-4">
				<li><strong>检查浏览器控制台</strong><br/>
					<code class="text-xs">await playwright_console_logs({'{'}type{':'} {''}error{'}'})</code><br/>
					<code class="text-xs">await playwright_console_logs({'{'}type{':'} {''}warning{'}'})</code>
				</li>
				<li><strong>检查后端日志</strong><br/>
					<code class="text-xs">tail -50 /tmp/backend.log</code>
				</li>
				<li><strong>测试 API 直连</strong><br/>
					<code class="text-xs">curl -s http://127.0.0.1:8000/api/knowledge/stats</code><br/>
					<code class="text-xs">curl -s http://127.0.0.1:8000/api/knowledge/categories</code>
				</li>
				<li><strong>检查 CORS</strong><br/>
					<code class="text-xs">curl -s -I -X OPTIONS http://127.0.0.1:8000/api/knowledge/stats -H "Origin: http://localhost:3000" -H "Access-Control-Request-Method: GET"</code>
				</li>
			</ol>

			<h2 id="fixes">5. 常见问题修复</h2>
			<h3>CORS 问题</h3>
			<p>修改 <code>backend/app/main.py</code>:</p>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{corsFixBlock}</pre>

			<h3>组件警告</h3>
			<ul class="list-disc pl-5 mb-4">
				<li><code>Spin tip</code> 警告 → 使用嵌套模式</li>
				<li><code>Select null value</code> → 使用 <code>undefined</code> 替代 <code>null</code></li>
			</ul>

			<h3>端口冲突</h3>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{`# 查找占用端口的进程
netstat -ano | findstr :3000

# 终止进程
taskkill /F /PID <PID>`}</pre>

			<h2 id="checklist">6. 测试检查清单</h2>
			<ul class="space-y-1 mb-4">
				<li>☐ 页面加载正常</li>
				<li>☐ 统计数据正确显示</li>
				<li>☐ API 请求返回 200</li>
				<li>☐ 控制台无错误</li>
				<li>☐ 按钮点击响应</li>
				<li>☐ 表单提交正常</li>
				<li>☐ 弹窗功能正常</li>
				<li>☐ 响应式布局正常</li>
			</ul>

			<h2 id="run">7. 测试命令速查</h2>
			<pre class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-sm overflow-x-auto mb-4 text-[var(--text-muted)]">{fullTestBlock}</pre>

			<h2 id="tips">8. 调试技巧</h2>
			<ol class="list-decimal pl-5 space-y-1 mb-6">
				<li><strong>强制刷新浏览器</strong>: <code>window.location.reload(true)</code></li>
				<li><strong>清除缓存</strong>: 关闭并重新打开浏览器</li>
				<li><strong>查看网络请求</strong>: 浏览器 DevTools → Network</li>
				<li><strong>单步调试</strong>: 使用 <code>playwright_evaluate</code> 执行 JS</li>
			</ol>

		</div>
	</div>
</MainGridLayout>
