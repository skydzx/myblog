---
import MainGridLayout from "@layouts/MainGridLayout.astro";

const archDiagram = `graph TB
    subgraph Blog["Blog - Astro + Fuwari"]
        A["📝 Posts 技术文章"]
        B["📚 KB 知识库"]
        C["📖 Docs 文档/Skills"]
        D["👤 About 关于"]
    end

    subgraph Pipeline["Content Pipeline"]
        E["🎨 Expressive Code 代码高亮"]
        F["📐 KaTeX 数学公式"]
        G["📊 Mermaid 图表"]
        H["🔍 Pagefind 全文搜索"]
    end

    subgraph Deploy["Deploy"]
        I["💻 GitHub 源码"]
        J["☁️ Cloudflare Pages 托管 + CDN"]
        K["🔒 geeyx.me 自定义域"]
    end

    A --> E
    A --> F
    A --> G
    B --> E
    B --> H
    C --> E
    C --> G
    I --> J
    J --> K`;

const mindmapDiagram = `mindmap
  root((棋密))
    Framework
      Astro 5.x
      Svelte 5
      Tailwind CSS 3
    Content
      Markdown + MDX
      Remark + Rehype
      Content Collections
    Rendering
      Expressive Code
      KaTeX LaTeX
      Mermaid Charts
    Search
      Pagefind
    Deploy
      Cloudflare Pages
      GitHub CI/CD
      Custom Domain`;

const docPages = [
	{
		name: "架构文档",
		slug: "architecture",
		desc: "目录职责、数据模型、路由表、配置参考、插件清单——项目真源文档",
	},
	{
		name: "设计规范",
		slug: "design-spec",
		desc: "风格方向、色彩系统、设计Token、组件库对齐——改 UI 前先读这个",
	},
	{
		name: "开发规范",
		slug: "dev-conventions",
		desc: "命名规则、函数设计、目录边界、质量检查——写代码前先读这个",
	},
];

const skills = [
	{
		name: "Software Testing Skill",
		slug: "software-testing",
		desc: "Playwright 自动化测试、环境检查、问题定位与修复流程",
	},
	{
		name: "System Testing Skill",
		slug: "system-testing",
		desc: "AI 知识库系统端到端测试，覆盖 Query、Knowledge、Settings 页面",
	},
];
---
<MainGridLayout title="文档" description="Project Documentation & Architecture">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full prose dark:prose-invert prose-base !max-w-none custom-md leading-relaxed">

		<h1 class="text-2xl font-bold mb-2">项目文档</h1>
		<p class="text-[var(--text-muted)] mb-6 leading-relaxed">
			本站基于 Astro + Fuwari 构建，部署于 Cloudflare Pages。以下为项目架构、技术栈及开发文档索引。
		</p>

		<hr class="my-8 border-[var(--border-color)]" />

		<!-- Architecture -->
		<h2 class="text-xl font-semibold mb-2">项目架构</h2>
		<p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">博客内容经 Markdown 解析后，分别由 Expressive Code、KaTeX、Mermaid 渲染，最终通过 Pagefind 建立全文索引。</p>
		<div class="card-base bg-[var(--card-bg-secondary)] p-4 mb-8"><div class="mermaid">{archDiagram}</div></div>

		<hr class="my-8 border-[var(--border-color)]" />

		<!-- Tech Stack -->
		<h2 class="text-xl font-semibold mb-2">技术栈</h2>
		<p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">项目采用 Astro 静态站点生成，Svelte 驱动交互组件，Tailwind CSS 原子化样式，Fuwari 主题提供基础布局。</p>
		<div class="card-base bg-[var(--card-bg-secondary)] p-4 mb-8"><div class="mermaid">{mindmapDiagram}</div></div>

		<hr class="my-8 border-[var(--border-color)]" />

		<!-- Doc Pages -->
		<h2 class="text-xl font-semibold mb-2">工程文档</h2>
		<p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">开发前必读的三份真源文档，定义项目规范与架构。</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
				{docPages.map((d) => (
					<a
						href={"/docs/" + d.slug + "/"}
						class="card-base px-4 py-4 block transition hover:border-[var(--primary)] hover:shadow-sm no-underline"
					>
						<div class="font-semibold text-[var(--text)] mb-1">{d.name}</div>
						<div class="text-sm text-[var(--text-muted)]">{d.desc}</div>
					</a>
				))}
			</div>

			<hr class="my-8 border-[var(--border-color)]" />

			<!-- Skills -->
			<h2 class="text-xl font-semibold mb-2">Claude Code Skills</h2>
			<p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">
				以下 Skills 定义于 AI 知识库项目中，供 Claude Code 代理调用，现存档于本站。
			</p>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
				{skills.map((s) => (
					<a
						href={"/docs/" + s.slug + "/"}
						class="card-base px-4 py-4 block transition hover:border-[var(--primary)] hover:shadow-sm no-underline"
					>
						<div class="font-semibold text-[var(--text)] mb-1">{s.name}</div>
						<div class="text-sm text-[var(--text-muted)]">{s.desc}</div>
					</a>
				))}
			</div>

			<hr class="my-8 border-[var(--border-color)]" />

			<!-- Directory Structure -->
			<h2 class="text-xl font-semibold mb-2">项目结构</h2>
			<p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">项目源码目录树，遵循开发规范中定义的目录边界。</p>
			<div class="card-base bg-[var(--card-bg-secondary)] p-4 font-mono text-xs leading-relaxed overflow-x-auto text-[var(--text-muted)]">
src/
├── <span class="text-[var(--primary)]">content/</span>
│   ├── posts/          ← 博客文章
│   ├── kb/             ← 知识库
│   └── spec/           ← 固定页面
├── <span class="text-[var(--primary)]">pages/</span>
│   ├── kb/             ← 知识库路由
│   ├── docs/           ← 文档 / 技能页
│   ├── [...page].astro ← 首页分页
│   └── about.astro
├── <span class="text-[var(--primary)]">components/</span>  ← 组件
├── <span class="text-[var(--primary)]">layouts/</span>     ← 布局
├── <span class="text-[var(--primary)]">plugins/</span>     ← Remark / Rehype 插件
├── <span class="text-[var(--primary)]">constants/</span>   ← 常量
└── config.ts          ← 站点配置
			</div>

		</div>
	</div>
</MainGridLayout>

<script type="module">
	import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
	mermaid.initialize({
		startOnLoad: true,
		theme: "dark",
		themeVariables: {
			fontFamily: "'JetBrains Mono Variable', ui-monospace, monospace",
		},
	});
</script>
